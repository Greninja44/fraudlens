# Copy to .env and adjust. Never commit .env.
FL_ENV=development
# REQUIRED outside development: a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
FL_SECRET_KEY=change-me-to-a-long-random-string
FL_ACCESS_TOKEN_MINUTES=480

POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=fraudlens
POSTGRES_DB=fraudlens
# Local (non-Docker) API uses this; docker-compose builds its own URL from the POSTGRES_* values.
FL_DATABASE_URL=postgresql+psycopg://fraudlens:fraudlens@localhost:5440/fraudlens

# Host ports
FL_DB_PORT=5440
FL_API_PORT=8100
FL_WEB_PORT=5180

# Evidence storage: local (default) or s3 (requires boto3 and the settings below)
FL_STORAGE_BACKEND=local
# FL_S3_BUCKET=
# FL_S3_ENDPOINT_URL=
FL_MAX_IMPORT_MB=200
FL_MAX_EVIDENCE_MB=50

# Seed demo users + synthetic data on first start (Docker). Demo password from FL_DEMO_PASSWORD.
FL_SEED_DEMO=true
FL_DEMO_PASSWORD=FraudLens-Demo-2026
